# Copy this file to .env and fill in your own values.
# .env is only read locally by deploy.sh - it is never sent anywhere else.
# Do not commit .env to any repo.

# --- Govee ---
# Govee Home app -> profile icon -> Settings -> About Us -> Apply for API Key
GOVEE_API_KEY=

# Optional: restrict which bulbs get controlled, as comma-separated sku:deviceId
# pairs (get these by testing the Lambda with {"action":"run_step",...} and
# checking the logs, or by calling GET /router/api/v1/user/devices yourself).
# Leave blank to control every device the API key can see.
GOVEE_DEVICE_FILTER=

# --- Location & schedule ---
# Decimal degrees. Get yours from Google Maps: right-click your house -> the
# top entry in the context menu is "lat, lng".
LATITUDE=
LONGITUDE=

# IANA timezone name, e.g. America/Chicago, America/New_York, America/Denver
TIMEZONE=America/Chicago

# Color temperature range for the sunset->midnight transition, in Kelvin.
# Lower = warmer/more orange. 4300 ~ warm white, 2200 ~ deep amber/candlelight.
START_KELVIN=4300
END_KELVIN=2200

# How many points to hit between sunset and local midnight (including both
# ends). 6 means: sunset, then 4 evenly-spaced steps, then midnight.
STEP_COUNT=6

# When the daily "plan tonight's schedule" job runs, as a UTC cron
# expression understood by EventBridge Scheduler. This MUST run before your
# earliest possible sunset of the year. For US Central time, 18:00 UTC
# (which is 12-1pm local depending on DST) is safe. Adjust for your timezone.
PLAN_CRON_UTC=cron(0 18 * * ? *)

# --- AWS ---
# Leave blank to use whatever region/profile your AWS CLI is already
# configured with.
AWS_REGION=
AWS_PROFILE=
