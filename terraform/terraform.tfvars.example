# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - it's only read locally by `terraform apply`.
# In CI, the same values come from GitHub Actions secrets/variables instead
# (see README.md).

aws_region = ""

# Govee Home app -> profile icon -> Settings -> About Us -> Apply for API Key
govee_api_key = ""

# Optional: restrict which bulbs get controlled, as comma-separated sku:deviceId
# pairs. Leave blank to control every device the API key can see.
govee_device_filter = ""

# Device id of your Govee app group (sku "SameModeGroup") containing all
# controlled bulbs - used for a single power on/off call at sunset and 1am
# instead of one call per bulb. Find it by invoking the Lambda with
# {"action":"list_devices"} and looking for the SameModeGroup entry.
group_device_id = ""

# Decimal degrees. Get yours from Google Maps: right-click your house -> the
# top entry in the context menu is "lat, lng".
latitude  = ""
longitude = ""

# IANA timezone name, e.g. America/Chicago, America/New_York, America/Denver
timezone = "America/Chicago"

# Color temperature curve, in Kelvin. Lower = warmer/more orange. 4300 ~ warm
# white, 2200 ~ deep amber/candlelight, 2000 ~ deepest amber most bulbs support.
# start_kelvin at sunset -> end_kelvin at 11pm -> night_kelvin at the last
# fade point just before 1am shutoff (the fade phase keeps warming past
# end_kelvin instead of holding flat).
start_kelvin = 4300
end_kelvin   = 2200
night_kelvin = 2000

# Brightness curve (percent, 1-100): start_brightness at sunset, dimming to
# evening_brightness by 11pm, then continuing to dim down to end_brightness
# right before the 1am shutoff.
start_brightness   = 60
evening_brightness = 30
end_brightness     = 10

# Number of extra warming/dimming points between 11pm and 1am for a smooth
# final fade, and how many minutes before 1am the last of those points lands
# (so it doesn't fire right on top of the 1am off step).
fade_step_count         = 3
fade_end_buffer_minutes = 25

# How many points to hit between sunset and local midnight (including both
# ends). 6 means: sunset, then 4 evenly-spaced steps, then midnight.
step_count = 6

# When the daily "plan tonight's schedule" job runs, as a UTC cron
# expression. This MUST run before your earliest possible sunset of the
# year. For US Central time, cron(0 18 * * ? *) (18:00 UTC, 12-1pm local
# depending on DST) is safe. Adjust for your timezone.
plan_cron_utc = "cron(0 18 * * ? *)"
